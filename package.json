{
  "name": "plugin",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=11.13.1"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:libs": "pnpm --filter @quartal/plugin-core --filter @quartal/plugin-embed --filter @quartal/plugin --filter @quartal/plugin-vue run build",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "changeset": "changeset",
    "version:packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm run build && changeset publish",
    "local-git-clean-up": "node scripts/local-git-clean-up.mjs",
    "deploy-plugin": "node deployment/deploy.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1"
  }
}
