---
import { docSections } from "../lib/docSections.ts";

interface Props {
  /** Collection id of the page being shown (highlighted). */
  currentId?: string;
  class?: string;
}
const { currentId, class: className } = Astro.props;

const bySection = await docSections();
---
<!-- The documentation tree: the docs pages' sidebar from md up, and the top bar's drawer below it. -->
<nav class:list={[className]}>
  {bySection.map((section) => (
    <div class="mb-4">
      <div class="text-uppercase text-secondary small fw-semibold mb-2">{section.title}</div>
      <ul class="nav flex-column">
        {section.entries.map((entry) => (
          <li class="nav-item">
            <a
              class:list={["nav-link px-0 py-1", entry.id === currentId ? "fw-semibold text-primary" : "link-body-emphasis"]}
              href={`/docs/${entry.id}/`}
            >
              {entry.data.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</nav>
