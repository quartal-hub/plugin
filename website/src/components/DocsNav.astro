---
import { docSections } from "../lib/docSections.ts";

interface Props {
  /** Collection id of the page being shown (highlighted). */
  currentId?: string;
  class?: string;
}
const { currentId, class: className } = Astro.props;

const bySection = await docSections();
---
<!-- The documentation tree: the docs pages' sidebar from md up, and the top bar's drawer below it.
     A ruled list per section, the current page in ink with an arrow (styles in site.css). -->
<nav class:list={["side-navi", className]} aria-label="Documentation">
  {bySection.map((section) => (
    <>
      <div class="side-kicker">{section.title}</div>
      <div class="list-group list-group-flush q-navi-level-2">
        {section.entries.map((entry) => (
          <a
            class:list={["list-group-item list-group-item-action", { selected: entry.id === currentId }]}
            href={`/docs/${entry.id}/`}
            aria-current={entry.id === currentId ? "page" : undefined}
          >
            {entry.data.title}
          </a>
        ))}
      </div>
    </>
  ))}
</nav>
