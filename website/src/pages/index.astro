---
import AgentPrompt from "../components/AgentPrompt.vue";
import CodeCompare from "../components/CodeCompare.vue";
import CommandPrompt from "../components/CommandPrompt.vue";
import BaseLayout from "../layouts/BaseLayout.astro";

const features = [
  {
    title: "Tools",
    text: "Plain TypeScript functions become MCP tools, an OpenAPI/REST service, and (optionally) an npm/JSR package — schemas generated from your types and JSDoc.",
    href: "/docs/tools/creating-tools/",
  },
  {
    title: "Widgets (MCP Apps)",
    text: "Give any tool a real UI, rendered inside Claude, ChatGPT, M365 Copilot and other MCP Apps hosts. Build it in Vue, React, Svelte — any framework.",
    href: "/docs/widgets/mcp-apps-widgets/",
  },
  {
    title: "Agent Skills",
    text: "Ship the know-how next to the tools: markdown skills (agentskills.io standard) that update automatically when you deploy.",
    href: "/docs/skills/agent-skills/",
  },
  {
    title: "Agents",
    text: "Interactive and autonomous agent definitions as markdown or JSON files, served from the plugin and included in its Agent Plugins package.",
    href: "/docs/more/agents/",
  },
  {
    title: "Prompts",
    text: "Guided starting points for interactive chat — a prompt is just a simple TypeScript function.",
    href: "/docs/more/prompts/",
  },
  {
    title: "Auth Built In",
    text: "Anonymous by default; standard OAuth2 when you need it — wired through MCP, REST, web components and the test UIs.",
    href: "/docs/auth/authentication/",
  },
];
---

<BaseLayout title="Quartal Plugins — package your business logic for AI agents">
  <div class="container">
    <!-- Intro: heading on the left, the text and actions on the right (stacked below lg). -->
    <section class="row gy-3 page-section page-intro">
      <div class="col-lg-6">
        <h1 class="display-2">Package Your Business Logic for AI Agents</h1>
      </div>
      <div class="col-lg-6 page-text">
        <p class="lead">
          Write plain TypeScript and Markdown once. Get MCP tools, chat widgets, agent skills,
          agents, prompts and a documented REST API from the same plugin package. Open source,
          MIT, zero lock-in.
        </p>
        <div class="d-flex flex-wrap align-items-center gap-3 mt-4">
          <a class="btn btn-primary" href="/docs/getting-started/">Get Started</a>
          <AgentPrompt client:load />
        </div>
        <div class="mt-4" style="max-width: 24rem;">
          <CommandPrompt client:load command="pnpm create @quartal/plugin" />
        </div>
      </div>
    </section>

    <div class="page-hero-media">
      <img
        src="/img/plugins-overview.svg"
        alt="Chatbots, autonomous agents, vibe-coding tools, corporate systems and software use Quartal Plugins: tools, widgets, skills, agents, prompts and auth over the business logic created by you"
        width="1004"
        height="651"
      />
    </div>

    <!-- 01: Define once, use anywhere -->
    <section class="row gy-3 page-section" id="anywhere">
      <div class="col-lg-5">
        <span class="page-eyebrow">01</span>
        <h2>Define Once, Use It from Anywhere</h2>
      </div>
      <div class="col-lg-7 page-text">
        <p class="lead">
          Build the agentic logic once; serve it to chatbots, autonomous agents, vibe-coding tools
          and traditional software.
        </p>
        <p>
          One plugin speaks <b>MCP, OpenAPI/REST, Agent Skills and the Agent Plugins package
          format</b>. Business users meet it in Claude, ChatGPT, Copilot and Gemini, agent builders
          wire it into their autonomous agents, vibe coders generate code against it, and
          developers integrate and embed it in corporate systems and their own software.
        </p>
      </div>
    </section>

    <!-- 02: Everything in one package -->
    <section class="page-section" id="features">
      <div class="row gy-3">
        <div class="col-lg-5">
          <span class="page-eyebrow">02</span>
          <h2>Everything an AI Agent Needs, in One Package</h2>
        </div>
        <div class="col-lg-7 page-text">
          <p class="lead">
            Tools, widgets, skills, agents, prompts and authentication live side by side in one
            Astro project and deploy together.
          </p>
        </div>
      </div>
      <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 gy-5 mt-2 ruled-cols">
        {
          features.map((f) => (
            <div class="col">
              <a class="ruled-link" href={f.href}>
                <h3 class="h6">{f.title}</h3>
                <p class="text-body-secondary">{f.text}</p>
              </a>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 03: Tools -->
    <section class="row gy-4 page-section" id="tools">
      <div class="col-lg-5">
        <span class="page-eyebrow">03</span>
        <h2>Tools Included</h2>
        <p class="lead">
          Create a set of tools for your agent with <b>plain TypeScript</b>. Hand-written or vibe
          coded — you decide. The <b>MCP server and OpenAPI</b> come automatically.
        </p>
        <h3 class="h6">No hand-written schemas. Just TypeScript.</h3>
        <p class="text-body-secondary">
          Most MCP frameworks make you describe every input and output twice — once for the
          compiler, once for the schema library. In a Quartal Plugin your interfaces, JSDoc
          comments and tags like <code>@format</code>, <code>@example</code> and
          <code>@visibility</code> are the schema. Real types, real reuse, nothing to keep in sync.
        </p>
        <a class="btn btn-outline-emphasis" href="/docs/tools/creating-tools/">Read the Tool Guide</a>
      </div>
      <div class="col-lg-7">
        <CodeCompare client:visible />
      </div>
    </section>

    <!-- 04: More in every plugin -->
    <section class="page-section" id="more">
      <div class="row gy-3">
        <div class="col-lg-5">
          <span class="page-eyebrow">04</span>
          <h2>More in Every Plugin</h2>
        </div>
        <div class="col-lg-7 page-text">
          <p class="lead">From your laptop to production, with the documentation done for you.</p>
        </div>
      </div>
      <div class="row row-cols-1 row-cols-md-3 gy-5 mt-2 ruled-cols">
        <div class="col">
          <h3 class="h6">Deploy Anywhere</h3>
          <p class="text-body-secondary">
            A plugin is a dynamic <a href="https://astro.build/" target="_blank" rel="noopener">Astro</a>
            site — deploy it to any modern hosting platform, then optionally publish the package to
            npm or JSR.
          </p>
        </div>
        <div class="col">
          <h3 class="h6">Docs Generated</h3>
          <p class="text-body-secondary">
            Every plugin ships its own documentation site, Swagger UI, widget tester and an
            integration skill for coding agents.
          </p>
        </div>
        <div class="col">
          <h3 class="h6">Open Source, Zero Lock-In</h3>
          <p class="text-body-secondary">
            MIT licensed, built on <a href="https://astro.build/" target="_blank" rel="noopener">Astro</a>
            (MIT) and open standards:
            <a href="https://modelcontextprotocol.io/" target="_blank" rel="noopener">MCP</a>,
            <a href="https://agentskills.io/" target="_blank" rel="noopener">Agent Skills</a>,
            <a href="https://agent-plugins.org/" target="_blank" rel="noopener">Agent Plugins</a> and
            <a href="https://www.openapis.org/" target="_blank" rel="noopener">OpenAPI</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- Closing call to action: a black section, as the visual guidelines end pages in dark. -->
    <section data-bs-theme="dark" class="page-cta">
      <div class="row gy-4">
        <div class="col-lg-5">
          <h2>Create Your First Plugin</h2>
        </div>
        <div class="col-lg-7 page-text">
          <p class="lead">
            Create a new Quartal Plugin project with the command below, then follow the Getting
            Started guide or prompt your favourite coding agent to build it with you.
          </p>
          <div class="d-flex flex-wrap align-items-center gap-3 mt-4">
            <a class="btn btn-primary" href="/docs/getting-started/">Get Started</a>
            <AgentPrompt client:load />
          </div>
          <div class="mt-4" style="max-width: 24rem;">
            <CommandPrompt client:load command="pnpm create @quartal/plugin" />
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
