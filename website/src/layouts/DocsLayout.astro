---
import { getCollection } from "astro:content";
import DocsNav from "../components/DocsNav.astro";
import { SECTIONS } from "../lib/sections.ts";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  /** Collection id of the page being shown (highlights it in the sidebar). */
  currentId?: string;
}
const { title, description, currentId } = Astro.props;

// The page path above the heading: Home / Documentation / <section>.
const entry = currentId ? (await getCollection("docs")).find((e) => e.id === currentId) : undefined;
const section = entry && SECTIONS.find((s) => s.key === entry.data.section);
---
<BaseLayout title={`${title} — Quartal Plugins`} description={description} currentId={currentId}>
  <div class="container docs-layout">
    <div class="row gy-4 gx-lg-5">
      <!-- Below md the top bar's drawer (BaseLayout) replaces this sidebar. -->
      <aside class="col-md-4 col-lg-3 d-none d-md-block">
        <DocsNav currentId={currentId} class="qp-docs-nav" />
      </aside>
      <div class="col-md-8 col-lg-9">
        <nav aria-label="Page path" class="site-path">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            {entry ? (
              <>
                <li class="breadcrumb-item"><a href="/docs/">Documentation</a></li>
                {section && <li class="breadcrumb-item active" aria-current="page">{section.title}</li>}
              </>
            ) : (
              <li class="breadcrumb-item active" aria-current="page">Documentation</li>
            )}
          </ol>
        </nav>
        <article class="qp-doc">
          <slot />
        </article>
      </div>
    </div>
  </div>
  <script>
    import { createApp } from "vue";
    import CommandPrompt from "../components/CommandPrompt.vue";

    /** Monaco language ids for the fence languages used in the docs markdown. */
    const LANGS: Record<string, string> = {
      ts: "typescript",
      typescript: "typescript",
      tsx: "typescript",
      js: "javascript",
      javascript: "javascript",
      jsx: "javascript",
      mjs: "javascript",
      json: "json",
      jsonc: "json",
      yaml: "yaml",
      yml: "yaml",
      html: "html",
      css: "css",
      scss: "scss",
      vue: "html",
      astro: "html",
      bash: "shell",
      sh: "shell",
      shell: "shell",
    };
    const COMMAND_RE = /^\s*(pnpm|npm|npx|node)\b/;

    // Upgrade the statically rendered markdown code blocks to <qrtl-editor> /
    // CommandPrompt. Blocks without a mapped language (e.g. `text` directory
    // trees) keep the plain <pre> rendering.
    document.querySelectorAll(".qp-doc pre[data-language]").forEach((pre) => {
      const lang = pre.getAttribute("data-language") ?? "";
      const monacoLang = LANGS[lang];
      if (!monacoLang) return;
      const code = (pre.textContent ?? "").replace(/\n$/, "");

      if (monacoLang === "shell" && COMMAND_RE.test(code)) {
        const host = document.createElement("div");
        host.className = "my-3";
        pre.replaceWith(host);
        createApp(CommandPrompt, { command: code }).mount(host);
        return;
      }

      const wrapper = document.createElement("div");
      wrapper.className = "qp-code-block overflow-hidden my-3";
      wrapper.style.height = `${Math.min(560, code.split("\n").length * 20 + 28)}px`;
      const editor = document.createElement("qrtl-editor");
      editor.setAttribute("type", "monaco");
      editor.setAttribute("lang", monacoLang);
      editor.setAttribute("read-only", "");
      editor.setAttribute("code", code);
      wrapper.append(editor);
      pre.replaceWith(wrapper);
    });
  </script>
</BaseLayout>
