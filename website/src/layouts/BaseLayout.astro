---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Quartal Plugins — packaged business functionality for AI agents." } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!-- Quartal default skin (full Bootstrap build + Quartal palette), same as plugin-docs-web. -->
    <link
      href="https://cdn.quartal.com/skins/default.css"
      rel="stylesheet"
    />
  </head>
  <body class="d-flex flex-column min-vh-100">
    <!-- Matches the TopNavi component of @quartal/plugin-docs-web. -->
    <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom border-primary border-5">
      <div class="container">
        <a class="navbar-brand" href="/">
          <img src="https://cdn.quartal.com/img/logo/quartal-logo-q.png" alt="Quartal" class="me-2" style="height: 32px;" />
          Quartal <span class="fw-semibold">Plugins</span>
        </a>
        <div class="navbar-nav flex-row gap-3">
          <a class="nav-link" href="/docs/getting-started/">Getting started</a>
          <a class="nav-link" href="/docs/">Documentation</a>
          <a class="nav-link" href="https://github.com/quartal-hub/plugin" target="_blank">GitHub</a>
        </div>
      </div>
    </nav>

    <main class="flex-grow-1">
      <slot />
    </main>

    <footer class="border-top py-4 mt-5">
      <div class="container d-flex flex-wrap justify-content-between text-body-secondary small">
        <span>Quartal Plugins — open source, MIT licensed.</span>
        <span>
          <a class="link-body-emphasis" href="https://github.com/quartal-hub/plugin" target="_blank">GitHub</a>
          ·
          <a class="link-body-emphasis" href="https://modelcontextprotocol.io/">MCP</a>
          ·
          <a class="link-body-emphasis" href="https://astro.build/">Astro</a>
        </span>
      </div>
    </footer>
    <script type="module" src="https://code.quartal.com/qrtl-editor.js"></script>
  </body>
</html>

<style is:global>
  /* The code.quartal.com editor elements render an iframe that fills the host;
     the host itself must be a sized block. */
  qrtl-editor,
  qrtl-editor-code,
  qrtl-editor-url {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Keep generated markdown tables and code readable inside Bootstrap. */
  .qp-doc table {
    width: 100%;
    margin-bottom: 1rem;
    border-collapse: collapse;
  }
  .qp-doc th,
  .qp-doc td {
    border: 1px solid var(--bs-border-color);
    padding: 0.5rem 0.75rem;
    vertical-align: top;
  }
  .qp-doc th {
    background: var(--bs-tertiary-bg);
    text-align: left;
  }
  .qp-doc pre {
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
  }
  .qp-doc blockquote {
    border-left: 4px solid var(--bs-info);
    padding-left: 1rem;
    color: var(--bs-secondary-color);
  }
  .qp-doc h2 {
    margin-top: 2.5rem;
  }
  .qp-doc h3 {
    margin-top: 1.75rem;
  }
</style>
