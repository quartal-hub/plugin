---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Quartal Plugins — packaged business functionality for AI agents." } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-md navbar-dark bg-dark">
      <div class="container">
        <a class="navbar-brand fw-semibold" href="/">Quartal <span class="text-info">Plugins</span></a>
        <div class="navbar-nav flex-row gap-3">
          <a class="nav-link" href="/docs/getting-started/">Getting started</a>
          <a class="nav-link" href="/docs/">Documentation</a>
          <a class="nav-link" href="https://github.com/quartal-hub/plugin">GitHub</a>
        </div>
      </div>
    </nav>

    <main class="flex-grow-1">
      <slot />
    </main>

    <footer class="border-top py-4 mt-5">
      <div class="container d-flex flex-wrap justify-content-between text-secondary small">
        <span>Quartal Plugins — open source, MIT licensed.</span>
        <span>
          <a class="link-secondary" href="https://github.com/quartal-hub/plugin">GitHub</a>
          ·
          <a class="link-secondary" href="https://modelcontextprotocol.io/">MCP</a>
          ·
          <a class="link-secondary" href="https://astro.build/">Astro</a>
        </span>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* Keep generated markdown tables and code readable inside Bootstrap. */
  .qp-doc table {
    width: 100%;
    margin-bottom: 1rem;
    border-collapse: collapse;
  }
  .qp-doc th,
  .qp-doc td {
    border: 1px solid var(--bs-border-color);
    padding: 0.5rem 0.75rem;
    vertical-align: top;
  }
  .qp-doc th {
    background: var(--bs-tertiary-bg);
    text-align: left;
  }
  .qp-doc pre {
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
  }
  .qp-doc blockquote {
    border-left: 4px solid var(--bs-info);
    padding-left: 1rem;
    color: var(--bs-secondary-color);
  }
  .qp-doc h2 {
    margin-top: 2.5rem;
  }
  .qp-doc h3 {
    margin-top: 1.75rem;
  }
</style>
