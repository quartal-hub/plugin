---
import "../styles/site.css";
import DocsNav from "../components/DocsNav.astro";

interface Props {
  title: string;
  description?: string;
  /** Collection id of the doc page being shown (highlighted in the drawer). */
  currentId?: string;
}
const { title, description = "Quartal Plugins — packaged business functionality for AI agents.", currentId } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!-- Quartal default skin (full Bootstrap build + Quartal palette), same as plugin-docs-web. -->
    <link
      href="https://cdn.quartal.com/skins/default.css"
      rel="stylesheet"
    />
  </head>
  <body class="d-flex flex-column min-vh-100">
    <!-- Matches the TopNavi component of @quartal/plugin-docs-web. Below md the toggler opens the
         documentation tree as a drawer (the site is the documentation); from md up the docs pages
         show the same tree as a sidebar and the top bar links to it. -->
    <nav class="navbar navbar-expand-md navbar-light bg-light border-bottom border-primary border-5">
      <div class="container">
        <button
          class="navbar-toggler me-2"
          type="button"
          data-qp-toggle="site-nav"
          aria-controls="site-nav"
          aria-expanded="false"
          aria-label="Toggle documentation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <a class="navbar-brand" href="/">
          <img src="https://cdn.quartal.com/img/logo/quartal-logo-q.png" alt="Quartal" class="me-2" style="height: 32px;" />
          Quartal <span class="fw-semibold">Plugins</span>
        </a>
        <div class="navbar-nav flex-row gap-3 d-none d-md-flex">
          <a class="nav-link" href="/docs/getting-started/">Getting started</a>
          <a class="nav-link" href="/docs/">Documentation</a>
        </div>
      </div>
    </nav>
    <div id="site-nav" class="offcanvas offcanvas-start" tabindex="-1" aria-labelledby="site-nav-title">
      <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="site-nav-title">Documentation</h5>
        <button type="button" class="btn-close" data-qp-toggle="site-nav" aria-label="Close"></button>
      </div>
      <div class="offcanvas-body">
        <DocsNav currentId={currentId} />
      </div>
    </div>
    <div class="offcanvas-backdrop fade" data-qp-backdrop="site-nav" data-qp-toggle="site-nav" hidden></div>

    <main class="flex-grow-1">
      <slot />
    </main>

    <footer class="border-top py-4 bg-body-secondary">
      <div class="container d-flex flex-wrap justify-content-between small">
        <span>Quartal Plugins — open source, MIT licensed.</span>
        <span>
          <a class="link-body-emphasis" href="https://github.com/quartal-hub/plugin" target="_blank">GitHub</a>
          <span> · </span>
          <a class="link-body-emphasis" href="https://modelcontextprotocol.io/" target="_blank">MCP</a>
          <span> · </span>
          <a class="link-body-emphasis" href="https://agentskills.io/" target="_blank">Agent Skills</a>
          <span> · </span>
          <a class="link-body-emphasis" href="https://agent-plugins.org/" target="_blank">Agent Plugins</a>
          <span> · </span>
          <a class="link-body-emphasis" href="https://www.openapis.org/" target="_blank">OpenAPI</a>
          <span> · </span>
          <a class="link-body-emphasis" href="https://astro.build/" target="_blank">Astro</a>
        </span>
      </div>
    </footer>
    <script type="module" src="https://code.quartal.com/qrtl-editor.js"></script>
    <script>
      import { initNavToggles } from "../lib/navToggle.ts";

      initNavToggles();
    </script>
  </body>
</html>
