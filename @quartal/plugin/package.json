{
  "name": "@quartal/plugin",
  "version": "1.0.0",
  "description": "The core plugin NPM package for creating Quartal plugins",
  "homepage": "https://plugin.quartal.com",
  "type": "module",
  "license": "MIT",
  "author": "Quartal Accounting Software Oy",
  "repository": {
    "type": "git",
    "url": "https://github.com/quartal-hub/plugin.git",
    "directory": "@quartal/plugin"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./astro": {
      "types": "./dist/astro/index.d.ts",
      "import": "./dist/astro/index.js",
      "default": "./dist/astro/index.js"
    },
    "./astro/route": {
      "types": "./dist/astro/catchAllRoute.d.ts",
      "import": "./dist/astro/catchAllRoute.js",
      "default": "./dist/astro/catchAllRoute.js"
    },
    "./widget": {
      "types": "./dist/widget/index.d.ts",
      "import": "./dist/widget/index.js",
      "default": "./dist/widget/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "@quartal/plugin-core": "workspace:*",
    "@quartal/plugin-embed": "workspace:*",
    "hono": "^4.13.14",
    "jose": "^6.2.14",
    "ts-morph": "^28.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.5",
    "@types/node": "^22.10.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
