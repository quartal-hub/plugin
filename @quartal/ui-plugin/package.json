{
  "name": "@quartal/ui-plugin",
  "version": "0.6.0",
  "description": "Vue components for visualizing Quartal plugin artifacts (tools, skills, services)",
  "type": "module",
  "license": "MIT",
  "author": "Quartal Accounting Software Oy",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "storybook dev -p 6007 --no-open",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build -o dist-storybook",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@quartal/plugin-core": "workspace:*",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/vue3": "^10.3.3",
    "@storybook/vue3-vite": "^10.3.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "storybook": "^10.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-dts": "^4.5.0",
    "vue": "^3.5.0",
    "vue-router": "^4.6.4",
    "vue-tsc": "^2.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/quartal-hub/plugin.git",
    "directory": "@quartal/ui-plugin"
  }
}
