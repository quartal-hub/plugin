{
  "name": "@quartal/ui-plugin",
  "version": "1.0.0",
  "description": "Vue components for visualizing Quartal plugin artifacts (tools, skills, services)",
  "homepage": "https://plugin.quartal.com",
  "type": "module",
  "license": "MIT",
  "author": "Quartal Accounting Software Oy",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "storybook dev -p 6007 --no-open",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build -o dist-storybook",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@quartal/plugin-core": "workspace:*",
    "@quartal/plugin-embed": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.6.4 || ^5.0.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.9",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/vue3": "^10.6.5",
    "@storybook/vue3-vite": "^10.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "storybook": "^10.6.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.14"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/quartal-hub/plugin.git",
    "directory": "@quartal/ui-plugin"
  }
}
