{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./dist",
    // Declarations import `@quartal/plugin-core` as a package (resolved to its built dist/mod.d.ts),
    // not the workspace sources: those live outside rootDir and would be emitted into dist.
    "paths": {}
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "exclude": ["src/**/*.stories.ts"]
}
