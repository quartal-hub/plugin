{
  "name": "@quartal/plugin-core",
  "version": "1.0.0",
  "description": "Core types and client for Quartal Plugins",
  "homepage": "https://plugin.quartal.com",
  "type": "module",
  "license": "MIT",
  "author": "Quartal Accounting Software Oy",
  "repository": {
    "type": "git",
    "url": "https://github.com/quartal-hub/plugin.git",
    "directory": "@quartal/plugin-core"
  },
  "main": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
